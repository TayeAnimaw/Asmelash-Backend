        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["date", "supplier_name", "purchase_order_no", "items"],
                "properties": {
                  "date": { "type": "string", "format": "date" },
                  "supplier_name": { "type": "string" },
                  "purchase_order_no": { "type": "string" },
                  "details": { "type": "string" },
                  "project_id": { "type": "integer" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["unit", "quantity", "unit_price"],
                      "properties": {
                        "item_id": { "type": "integer" },
                        "stock_code": { "type": "string" },
                        "unit": { "type": "string" },
                        "quantity": { "type": "number" },
                        "unit_price": { "type": "number" },
                        "details": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "GRN created successfully" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/grns/{id}": {
