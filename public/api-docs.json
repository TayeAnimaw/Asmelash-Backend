    "/stock-balances": {
      "get": {
        "tags": ["Stock Balance"],
        "summary": "Get all stock balances",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "project_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Stock balances retrieved successfully" }
        }
      },
      "post": {
        "tags": ["Stock Balance"],
